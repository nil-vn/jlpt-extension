{
  "name": "jlpt-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev:wails": "vite --config vite.wails.config.ts",
    "build:wails": "vite build --config vite.wails.config.ts",
    "wails:dev": "wails3 dev",
    "wails:build": "wails3 build",
    "wails:build:windows": "wails3 build GOOS=windows"
  },
  "dependencies": {
    "@lucide/svelte": "^1.16.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "svelte": "latest",
    "tailwind-merge": "^3.6.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "latest",
    "@types/chrome": "latest",
    "@types/node": "latest",
    "svelte-check": "latest",
    "typescript": "latest"
  }
}
