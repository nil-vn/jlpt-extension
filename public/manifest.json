{
  "manifest_version": 3,
  "name": "JLPT Study Companion",
  "description": "A lightweight JLPT flashcard and vocabulary review extension.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JLPT Study Companion"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "icons": {}
}
