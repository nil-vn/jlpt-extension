{
  "manifest_version": 3,
  "name": "JLPT Study Companion",
  "description": "A lightweight JLPT flashcard and vocabulary review extension.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JLPT Study Companion",
    "default_icon": {
      "16": "logo.svg",
      "32": "logo.svg",
      "48": "logo.svg",
      "128": "logo.svg"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "icons": {
    "16": "logo.svg",
    "32": "logo.svg",
    "48": "logo.svg",
    "128": "logo.svg"
  }
}
